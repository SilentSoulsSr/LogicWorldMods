###################
# Repeater Module #
###################

DebugDisplay:
    column: "Memory"
    category: "Modules"

    prefab:
        blocks:
            -
                scale: (2, 0.333, 3)
                position: ( -0.5, 0, -0.5)
                mesh: OriginCube
        inputs:
            -
                position: (1.3, 0.0, -0.333)
                rotation: (180, 0, 0)
                length: 0.6
            -
                position: (1.3, 0.0, 0)
                rotation: (180, 0, 0)
                length: 0.6
            -
                position: (1.3, 0.0, 0.333)
                rotation: (180, 0, 0)
                length: 0.6
            -
                position: (1.3, 0.0, 0.666)
                rotation: (180, 0, 0)
                length: 0.6
            -
                position: (1.3, 0.0, 1.0)
                rotation: (180, 0, 0)
                length: 0.6
            -
                position: (1.3, 0.0, 1.333)
                rotation: (180, 0, 0)
                length: 0.6
            -
                position: (1.3, 0.0, 1.666)
                rotation: (180, 0, 0)
                length: 0.6
            -
                position: (1.3, 0.0, 2.0)
                rotation: (180, 0, 0)
                length: 0.6
    logicCode: SilentsDebugDisplay.Server.LogicCode.DebugDisplay
    clientCode: SilentsDebugDisplay.Client.ClientCode.DebugDisplay
    placingRules:
        offsetDimensions: (3, 1)
        defaultOffset: (0, 0)
        gridPlacingDimensions: (3, 1)
    codeInfoFloats:
        - 0.333 # height
