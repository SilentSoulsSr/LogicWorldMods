###################
# Repeater Module #
###################

Repeater:
    column: "Memory"
    category: "Modules"

    prefab:
        blocks:
            -
                scale: (1, 1/4, 1)
                position: (0.0, 0, 0)
        inputs:
            -
                position: (-1/4, 0, -1/4)
                rotation: (0, 0, 0)
                length: 0.75
#   Reset
            -
                position: (1/4, 0, -1/4)
                rotation: (0, 0, 0)
                length: 0.75
        outputs:
            -
                position: (0, 0, 1/5)
                rotation: (0, 0, 0)
    logicCode: SilentsRepeater.Server.LogicCode.Repeater
    clientCode: SilentsRepeater.Client.ClientCode.Repeater
    placingRules:
        gridPlacingDimensions: (1, 1)
    codeInfoFloats:
        - -0.5 # X Text
        - 0.50 # Y
        - -0.30 # Z
